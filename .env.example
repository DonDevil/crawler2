# Copy to .env (git-ignored) and change the credentials. Development only.
COMPOSE_PROJECT_NAME=crawler2
# "single" = one app host; "two-host" = app-host-1 + app-host-2 (plan B.4 #8)
COMPOSE_PROFILES=single

MINIO_ROOT_USER=crawler2-dev
MINIO_ROOT_PASSWORD=change-me-dev-only

# Host-side ports (bound to 127.0.0.1 only). Containers never use these.
REDIS_HOST_PORT=16379
SCYLLA_HOST_PORT=19042
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# Any crawler2 setting can be overridden with CRAWLER2_<FIELD> /
# CRAWLER2_<SECTION>__<FIELD>, e.g.:
# CRAWLER2_LOGGING__LEVEL=DEBUG
# CRAWLER2_LIMITS__HTTP_CONCURRENCY=32
