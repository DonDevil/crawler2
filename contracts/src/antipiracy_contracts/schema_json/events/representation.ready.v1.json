{
  "$defs": {
    "Component": {
      "description": "Logical producers/consumers of events. Each belongs to exactly one service.",
      "enum": [
        "crawl_intelligence",
        "frontier",
        "crawler_worker",
        "extraction",
        "media_registry",
        "feedback",
        "evidence_collector",
        "evidence_finalizer",
        "evidence_exporter",
        "target_manager",
        "encoder",
        "matcher"
      ],
      "title": "Component",
      "type": "string"
    },
    "Producer": {
      "description": "Who emitted an event: service, component and the concrete process instance.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Component"
        },
        "instance": {
          "pattern": "^[A-Za-z0-9._:-]{1,200}$",
          "title": "Instance",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceName"
        }
      },
      "required": [
        "service",
        "component",
        "instance"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Representation": {
      "description": "Metadata of a stored representation of one content identity. Rebuildable.\n\nVectors are not part of the contract; they live in fingerprinter storage.",
      "properties": {
        "content_id": {
          "pattern": "^cnt_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Content Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Duration Seconds"
        },
        "representation_id": {
          "pattern": "^rep_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Representation Id",
          "type": "string"
        },
        "segment_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Count"
        },
        "spec": {
          "$ref": "#/$defs/RepresentationSpec"
        }
      },
      "required": [
        "representation_id",
        "content_id",
        "spec",
        "created_at"
      ],
      "title": "Representation",
      "type": "object"
    },
    "RepresentationReady": {
      "description": "A representation exists (newly created or already present) for a content identity.",
      "properties": {
        "representation": {
          "$ref": "#/$defs/Representation"
        }
      },
      "required": [
        "representation"
      ],
      "title": "RepresentationReady",
      "type": "object"
    },
    "RepresentationSpec": {
      "description": "How a representation is computed. Different spec => different representation.",
      "properties": {
        "config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "config_digest"
      ],
      "title": "RepresentationSpec",
      "type": "object"
    },
    "ServiceName": {
      "description": "Deployable services. Each owns its own keyspace in the shared Scylla cluster.",
      "enum": [
        "crawler2",
        "fingerprinter"
      ],
      "title": "ServiceName",
      "type": "string"
    }
  },
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "pattern": "^cor_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "envelope_version": {
      "const": 1,
      "title": "Envelope Version",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$",
      "title": "Event Type",
      "type": "string"
    },
    "metadata": {
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]{0,63}$": {
          "maxLength": 500,
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/RepresentationReady"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "schema_version": {
      "pattern": "^[1-9][0-9]{0,3}\\.(0|[1-9][0-9]{0,3})$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "envelope_version",
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "title": "representation.ready v1.0",
  "type": "object"
}
