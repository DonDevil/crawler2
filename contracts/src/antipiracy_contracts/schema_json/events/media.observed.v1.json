{
  "$defs": {
    "Component": {
      "description": "Logical producers/consumers of events. Each belongs to exactly one service.",
      "enum": [
        "crawl_intelligence",
        "frontier",
        "crawler_worker",
        "extraction",
        "media_registry",
        "feedback",
        "evidence_collector",
        "evidence_finalizer",
        "evidence_exporter",
        "target_manager",
        "encoder",
        "matcher"
      ],
      "title": "Component",
      "type": "string"
    },
    "ContentKey": {
      "description": "Level-3 candidate content identity: a digest of sampled bytes under a named scheme.\n\nEqual keys mean \"the sampled bytes were identical\" and justify skipping\nduplicate work. They never justify merging media records irreversibly,\nand a representation-level disagreement (level 4) overrides them.",
      "properties": {
        "content_id": {
          "pattern": "^cnt_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Content Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "scheme": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}/v[1-9][0-9]*$",
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "digest",
        "content_id"
      ],
      "title": "ContentKey",
      "type": "object"
    },
    "Media": {
      "description": "A media resource known to the registry, identified by its locator (level 1).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "locator": {
          "$ref": "#/$defs/UrlRef"
        },
        "media_id": {
          "pattern": "^med_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Media Id",
          "type": "string"
        }
      },
      "required": [
        "media_id",
        "locator",
        "kind"
      ],
      "title": "Media",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "video_file",
        "hls_manifest",
        "dash_manifest",
        "audio_file",
        "unknown"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "MediaObservation": {
      "description": "Media seen on one page observation, as resolved by the media registry.\n\nIdentified by the pair (``page_observation_id``, ``media.media_id``).",
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalHints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "page": {
          "$ref": "#/$defs/UrlRef"
        },
        "page_observation_id": {
          "pattern": "^obs_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Page Observation Id",
          "type": "string"
        },
        "page_version_id": {
          "pattern": "^pgv_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Page Version Id",
          "type": "string"
        },
        "probe_status": {
          "$ref": "#/$defs/ProbeStatus"
        }
      },
      "required": [
        "media",
        "page_observation_id",
        "page",
        "page_version_id",
        "observed_at",
        "probe_status"
      ],
      "title": "MediaObservation",
      "type": "object"
    },
    "MediaObserved": {
      "description": "The media registry resolved (and possibly probed) one media reference.",
      "properties": {
        "observation": {
          "$ref": "#/$defs/MediaObservation"
        }
      },
      "required": [
        "observation"
      ],
      "title": "MediaObserved",
      "type": "object"
    },
    "ProbeStatus": {
      "enum": [
        "not_probed",
        "probed",
        "unreachable",
        "forbidden",
        "not_media"
      ],
      "title": "ProbeStatus",
      "type": "string"
    },
    "Producer": {
      "description": "Who emitted an event: service, component and the concrete process instance.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Component"
        },
        "instance": {
          "pattern": "^[A-Za-z0-9._:-]{1,200}$",
          "title": "Instance",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceName"
        }
      },
      "required": [
        "service",
        "component",
        "instance"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ServiceName": {
      "description": "Deployable services. Each owns its own keyspace in the shared Scylla cluster.",
      "enum": [
        "crawler2",
        "fingerprinter"
      ],
      "title": "ServiceName",
      "type": "string"
    },
    "TechnicalHints": {
      "description": "Level-2 signals from a cheap probe. Hints only: equal hints prove nothing.",
      "properties": {
        "content_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Length"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "etag": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        }
      },
      "title": "TechnicalHints",
      "type": "object"
    },
    "UrlRef": {
      "description": "A canonical URL together with its derived IDs.\n\nCarrying the IDs saves every consumer from re-deriving them; validation\nguarantees they match the URL, so a producer cannot send a mismatched pair.",
      "properties": {
        "domain_id": {
          "pattern": "^dom_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Domain Id",
          "type": "string"
        },
        "url": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "url_id": {
          "pattern": "^url_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Url Id",
          "type": "string"
        }
      },
      "required": [
        "url",
        "url_id",
        "domain_id"
      ],
      "title": "UrlRef",
      "type": "object"
    }
  },
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "pattern": "^cor_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "envelope_version": {
      "const": 1,
      "title": "Envelope Version",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$",
      "title": "Event Type",
      "type": "string"
    },
    "metadata": {
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]{0,63}$": {
          "maxLength": 500,
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/MediaObserved"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "schema_version": {
      "pattern": "^[1-9][0-9]{0,3}\\.(0|[1-9][0-9]{0,3})$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "envelope_version",
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "title": "media.observed v1.0",
  "type": "object"
}
