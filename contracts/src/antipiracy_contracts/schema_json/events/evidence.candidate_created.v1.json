{
  "$defs": {
    "ArtifactRole": {
      "enum": [
        "page_snapshot",
        "media_sample",
        "screenshot",
        "other"
      ],
      "title": "ArtifactRole",
      "type": "string"
    },
    "BlobRef": {
      "description": "An immutable stored object, located by an opaque URI and pinned by its digest.\n\nThe key layout behind ``uri`` belongs to the storage layer (P2); consumers\nonly dereference it and verify ``digest``. Because the digest is part of\nthe reference, a reference can never silently point at different bytes.",
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "maxLength": 2048,
          "pattern": "^[a-z][a-z0-9+.-]*://\\S+$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "digest",
        "size_bytes"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "Component": {
      "description": "Logical producers/consumers of events. Each belongs to exactly one service.",
      "enum": [
        "crawl_intelligence",
        "frontier",
        "crawler_worker",
        "extraction",
        "media_registry",
        "feedback",
        "evidence_collector",
        "evidence_finalizer",
        "evidence_exporter",
        "target_manager",
        "encoder",
        "matcher"
      ],
      "title": "Component",
      "type": "string"
    },
    "EvidenceArtifact": {
      "properties": {
        "blob": {
          "$ref": "#/$defs/BlobRef"
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole"
        }
      },
      "required": [
        "role",
        "blob"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    },
    "EvidenceCandidate": {
      "description": "Everything collected for one match, before completeness checks and freezing.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceArtifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "content_id": {
          "pattern": "^cnt_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Content Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^evd_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "match_id": {
          "pattern": "^mat_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Match Id",
          "type": "string"
        },
        "media_ids": {
          "items": {
            "pattern": "^med_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Media Ids",
          "type": "array"
        },
        "page_observation_ids": {
          "items": {
            "pattern": "^obs_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Page Observation Ids",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        }
      },
      "required": [
        "evidence_id",
        "match_id",
        "target",
        "content_id",
        "media_ids",
        "page_observation_ids",
        "collected_at"
      ],
      "title": "EvidenceCandidate",
      "type": "object"
    },
    "EvidenceCandidateCreated": {
      "properties": {
        "candidate": {
          "$ref": "#/$defs/EvidenceCandidate"
        }
      },
      "required": [
        "candidate"
      ],
      "title": "EvidenceCandidateCreated",
      "type": "object"
    },
    "Producer": {
      "description": "Who emitted an event: service, component and the concrete process instance.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Component"
        },
        "instance": {
          "pattern": "^[A-Za-z0-9._:-]{1,200}$",
          "title": "Instance",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceName"
        }
      },
      "required": [
        "service",
        "component",
        "instance"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ServiceName": {
      "description": "Deployable services. Each owns its own keyspace in the shared Scylla cluster.",
      "enum": [
        "crawler2",
        "fingerprinter"
      ],
      "title": "ServiceName",
      "type": "string"
    },
    "TargetRef": {
      "description": "A specific version of a target. Matches are always against a version.",
      "properties": {
        "target_id": {
          "pattern": "^tgt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Target Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "target_id",
        "version"
      ],
      "title": "TargetRef",
      "type": "object"
    }
  },
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "pattern": "^cor_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "envelope_version": {
      "const": 1,
      "title": "Envelope Version",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$",
      "title": "Event Type",
      "type": "string"
    },
    "metadata": {
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]{0,63}$": {
          "maxLength": 500,
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/EvidenceCandidateCreated"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "schema_version": {
      "pattern": "^[1-9][0-9]{0,3}\\.(0|[1-9][0-9]{0,3})$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "envelope_version",
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "title": "evidence.candidate_created v1.0",
  "type": "object"
}
