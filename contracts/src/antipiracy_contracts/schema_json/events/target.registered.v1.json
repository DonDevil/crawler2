{
  "$defs": {
    "Component": {
      "description": "Logical producers/consumers of events. Each belongs to exactly one service.",
      "enum": [
        "crawl_intelligence",
        "frontier",
        "crawler_worker",
        "extraction",
        "media_registry",
        "feedback",
        "evidence_collector",
        "evidence_finalizer",
        "evidence_exporter",
        "target_manager",
        "encoder",
        "matcher"
      ],
      "title": "Component",
      "type": "string"
    },
    "Producer": {
      "description": "Who emitted an event: service, component and the concrete process instance.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Component"
        },
        "instance": {
          "pattern": "^[A-Za-z0-9._:-]{1,200}$",
          "title": "Instance",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceName"
        }
      },
      "required": [
        "service",
        "component",
        "instance"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ServiceName": {
      "description": "Deployable services. Each owns its own keyspace in the shared Scylla cluster.",
      "enum": [
        "crawler2",
        "fingerprinter"
      ],
      "title": "ServiceName",
      "type": "string"
    },
    "Target": {
      "description": "One version of a protected work, as published by the target manager.",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "ref": {
          "$ref": "#/$defs/TargetRef"
        },
        "registered_at": {
          "format": "date-time",
          "title": "Registered At",
          "type": "string"
        },
        "release_year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1870,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Year"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "title",
        "kind",
        "registered_at"
      ],
      "title": "Target",
      "type": "object"
    },
    "TargetKind": {
      "enum": [
        "movie",
        "series_episode",
        "live_event",
        "other"
      ],
      "title": "TargetKind",
      "type": "string"
    },
    "TargetRef": {
      "description": "A specific version of a target. Matches are always against a version.",
      "properties": {
        "target_id": {
          "pattern": "^tgt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Target Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "target_id",
        "version"
      ],
      "title": "TargetRef",
      "type": "object"
    },
    "TargetRegistered": {
      "description": "A target, or a new version of one, is ready for matching.",
      "properties": {
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "target"
      ],
      "title": "TargetRegistered",
      "type": "object"
    }
  },
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "pattern": "^cor_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "envelope_version": {
      "const": 1,
      "title": "Envelope Version",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$",
      "title": "Event Type",
      "type": "string"
    },
    "metadata": {
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]{0,63}$": {
          "maxLength": 500,
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/TargetRegistered"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "schema_version": {
      "pattern": "^[1-9][0-9]{0,3}\\.(0|[1-9][0-9]{0,3})$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "envelope_version",
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "title": "target.registered v1.0",
  "type": "object"
}
