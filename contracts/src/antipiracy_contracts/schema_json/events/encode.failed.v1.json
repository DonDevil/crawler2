{
  "$defs": {
    "Component": {
      "description": "Logical producers/consumers of events. Each belongs to exactly one service.",
      "enum": [
        "crawl_intelligence",
        "frontier",
        "crawler_worker",
        "extraction",
        "media_registry",
        "feedback",
        "evidence_collector",
        "evidence_finalizer",
        "evidence_exporter",
        "target_manager",
        "encoder",
        "matcher"
      ],
      "title": "Component",
      "type": "string"
    },
    "EncodeFailed": {
      "description": "An encode request could not be satisfied. Never a \"no match\": no decision was made.",
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "content_id": {
          "pattern": "^cnt_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Content Id",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "failure": {
          "$ref": "#/$defs/EncodeFailure"
        },
        "request_id": {
          "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Request Id",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepresentationSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id",
        "content_id",
        "failure",
        "retryable",
        "attempt"
      ],
      "title": "EncodeFailed",
      "type": "object"
    },
    "EncodeFailure": {
      "enum": [
        "source_unreachable",
        "source_forbidden",
        "unsupported_format",
        "too_large",
        "decode_error",
        "timeout",
        "internal_error"
      ],
      "title": "EncodeFailure",
      "type": "string"
    },
    "Producer": {
      "description": "Who emitted an event: service, component and the concrete process instance.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Component"
        },
        "instance": {
          "pattern": "^[A-Za-z0-9._:-]{1,200}$",
          "title": "Instance",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceName"
        }
      },
      "required": [
        "service",
        "component",
        "instance"
      ],
      "title": "Producer",
      "type": "object"
    },
    "RepresentationSpec": {
      "description": "How a representation is computed. Different spec => different representation.",
      "properties": {
        "config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "config_digest"
      ],
      "title": "RepresentationSpec",
      "type": "object"
    },
    "ServiceName": {
      "description": "Deployable services. Each owns its own keyspace in the shared Scylla cluster.",
      "enum": [
        "crawler2",
        "fingerprinter"
      ],
      "title": "ServiceName",
      "type": "string"
    }
  },
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "pattern": "^cor_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "envelope_version": {
      "const": 1,
      "title": "Envelope Version",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$",
      "title": "Event Type",
      "type": "string"
    },
    "metadata": {
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]{0,63}$": {
          "maxLength": 500,
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/EncodeFailed"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "schema_version": {
      "pattern": "^[1-9][0-9]{0,3}\\.(0|[1-9][0-9]{0,3})$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "envelope_version",
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "title": "encode.failed v1.0",
  "type": "object"
}
