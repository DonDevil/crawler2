{
  "$defs": {
    "Component": {
      "description": "Logical producers/consumers of events. Each belongs to exactly one service.",
      "enum": [
        "crawl_intelligence",
        "frontier",
        "crawler_worker",
        "extraction",
        "media_registry",
        "feedback",
        "evidence_collector",
        "evidence_finalizer",
        "evidence_exporter",
        "target_manager",
        "encoder",
        "matcher"
      ],
      "title": "Component",
      "type": "string"
    },
    "FetchAttempt": {
      "description": "One execution of fetching a URL, including failures.\n\nFailed attempts are first-class: fetch-profile learning (P7) needs to\nknow which capability did *not* work.",
      "properties": {
        "bytes_received": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Received"
        },
        "capability": {
          "$ref": "#/$defs/FetchCapability"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "fetch_attempt_id": {
          "pattern": "^fat_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Fetch Attempt Id",
          "type": "string"
        },
        "final": {
          "anyOf": [
            {
              "$ref": "#/$defs/UrlRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "outcome": {
          "$ref": "#/$defs/FetchOutcome"
        },
        "redirects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RedirectHop"
          },
          "title": "Redirects",
          "type": "array"
        },
        "requested": {
          "$ref": "#/$defs/UrlRef"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "worker": {
          "pattern": "^[A-Za-z0-9._:-]{1,200}$",
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "fetch_attempt_id",
        "requested",
        "capability",
        "worker",
        "started_at",
        "finished_at",
        "outcome"
      ],
      "title": "FetchAttempt",
      "type": "object"
    },
    "FetchCapability": {
      "description": "What a fetch could do, independent of which library implemented it.",
      "enum": [
        "http",
        "browser",
        "tor_http",
        "tor_browser"
      ],
      "title": "FetchCapability",
      "type": "string"
    },
    "FetchCompleted": {
      "description": "A fetch attempt ended, successfully or not.",
      "properties": {
        "attempt": {
          "$ref": "#/$defs/FetchAttempt"
        }
      },
      "required": [
        "attempt"
      ],
      "title": "FetchCompleted",
      "type": "object"
    },
    "FetchOutcome": {
      "description": "How a fetch attempt ended. Only ``RESPONSE`` produced an HTTP response.",
      "enum": [
        "response",
        "timeout",
        "dns_failure",
        "connection_failure",
        "tls_failure",
        "blocked",
        "too_large",
        "cancelled"
      ],
      "title": "FetchOutcome",
      "type": "string"
    },
    "Producer": {
      "description": "Who emitted an event: service, component and the concrete process instance.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Component"
        },
        "instance": {
          "pattern": "^[A-Za-z0-9._:-]{1,200}$",
          "title": "Instance",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceName"
        }
      },
      "required": [
        "service",
        "component",
        "instance"
      ],
      "title": "Producer",
      "type": "object"
    },
    "RedirectHop": {
      "properties": {
        "location": {
          "$ref": "#/$defs/UrlRef"
        },
        "status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "status"
      ],
      "title": "RedirectHop",
      "type": "object"
    },
    "ServiceName": {
      "description": "Deployable services. Each owns its own keyspace in the shared Scylla cluster.",
      "enum": [
        "crawler2",
        "fingerprinter"
      ],
      "title": "ServiceName",
      "type": "string"
    },
    "UrlRef": {
      "description": "A canonical URL together with its derived IDs.\n\nCarrying the IDs saves every consumer from re-deriving them; validation\nguarantees they match the URL, so a producer cannot send a mismatched pair.",
      "properties": {
        "domain_id": {
          "pattern": "^dom_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Domain Id",
          "type": "string"
        },
        "url": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "url_id": {
          "pattern": "^url_[0-9a-f]{12}8[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "title": "Url Id",
          "type": "string"
        }
      },
      "required": [
        "url",
        "url_id",
        "domain_id"
      ],
      "title": "UrlRef",
      "type": "object"
    }
  },
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "pattern": "^cor_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "envelope_version": {
      "const": 1,
      "title": "Envelope Version",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_]*$",
      "title": "Event Type",
      "type": "string"
    },
    "metadata": {
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]{0,63}$": {
          "maxLength": 500,
          "type": "string"
        }
      },
      "title": "Metadata",
      "type": "object"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/FetchCompleted"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "schema_version": {
      "pattern": "^[1-9][0-9]{0,3}\\.(0|[1-9][0-9]{0,3})$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "envelope_version",
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "title": "fetch.completed v1.0",
  "type": "object"
}
