# /etc/crawler2/secrets.env  (mode 0600 root:root; never committed; values come from your secret store)
# Least-privilege credentials per service - NOT the MinIO root user (see security.md).
CRAWLER2_REDIS__PASSWORD=
CRAWLER2_SCYLLA__USERNAME=
CRAWLER2_SCYLLA__PASSWORD=
CRAWLER2_MINIO__ACCESS_KEY=
CRAWLER2_MINIO__SECRET_KEY=
