# /etc/crawler2/crawler2.env  (mode 0644, no secrets). One file per host; roles are chosen by
# enabling units, not here. Every setting is CRAWLER2_<SECTION>__<NAME>.
CRAWLER2_ENVIRONMENT=prod
CRAWLER2_REDIS__HOST=REDIS_HOST
CRAWLER2_REDIS__PORT=6379
CRAWLER2_SCYLLA__CONTACT_POINTS=SCYLLA_1,SCYLLA_2,SCYLLA_3
CRAWLER2_MINIO__ENDPOINT=MINIO_HOST:9000
CRAWLER2_METRICS__BIND=0.0.0.0        # restrict with the host firewall to the Prometheus host
CRAWLER2_SCRATCH_DIR=/var/lib/crawler2/scratch
